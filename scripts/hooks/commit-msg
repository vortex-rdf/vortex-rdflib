#!/usr/bin/env bash
# Installed as the repo's commit-msg hook (see scripts/install-git-hooks.sh).
# Enforces Conventional Commits (https://www.conventionalcommits.org), same
# convention as the vortex-rdf repository.
# Skip once with `git commit --no-verify`.
set -euo pipefail

msg_file="$1"
# First non-comment, non-empty line = the commit subject.
subject="$(grep -vE '^\s*#' "$msg_file" | grep -vE '^\s*$' | head -n1 || true)"

# Let git's own housekeeping commits through untouched.
case "$subject" in
  Merge\ *|Revert\ *|"fixup! "*|"squash! "*|Reapply\ *) exit 0 ;;
esac

# type(optional scope)(optional !): description
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9,._/-]+\))?!?: .+'

if [[ ! "$subject" =~ $pattern ]]; then
  cat >&2 <<EOF
✖ Commit message is not a Conventional Commit.

  Got:      $subject

  Expected: <type>[optional scope][!]: <description>
  Types:    feat fix docs style refactor perf test build ci chore revert
  Examples: feat(store): expose max_resident_terms on VortexStore
            fix(pushdown): fall back on RDF-star patterns
            ci: gate release on the full test matrix

Skip this check once with: git commit --no-verify
EOF
  exit 1
fi
